{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:darkbox:sync-schema:1.0.0",
  "title": "Darkbox synchronization extension 1.0.0",
  "$comment": "Structural validation only. Canonical bytes, identity, counters, causal closure, author-context operation validity, hash/length, sorted uniqueness, complete resource closure and projection require additional checks.",
  "oneOf": [
    {
      "$ref": "#/$defs/domain"
    },
    {
      "$ref": "#/$defs/mapping"
    },
    {
      "$ref": "#/$defs/replica"
    },
    {
      "$ref": "#/$defs/transaction"
    },
    {
      "$ref": "#/$defs/segment"
    },
    {
      "$ref": "#/$defs/receipt"
    },
    {
      "$ref": "#/$defs/state"
    },
    {
      "$ref": "#/$defs/checkpoint"
    },
    {
      "$ref": "#/$defs/snapshot"
    },
    {
      "$ref": "#/$defs/extension"
    },
    {
      "$ref": "#/$defs/baseline"
    },
    {
      "$ref": "#/$defs/repository"
    },
    {
      "$ref": "#/$defs/generation"
    },
    {
      "$ref": "#/$defs/retirement"
    },
    {
      "$ref": "#/$defs/recovery"
    }
  ],
  "$defs": {
    "counter": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]{0,19})$",
      "$comment": "Additionally enforce unsigned 64-bit maximum 18446744073709551615."
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,63}$"
    },
    "dot": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}:[1-9][0-9]{0,19}:(?:0|[1-9][0-9]{0,3})$",
      "$comment": "Sequence is unsigned 64-bit and positive; index is at most 4095."
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[A-Za-z0-9._/-]+$",
      "$comment": "Also enforce common path identity, reserved paths, ancestors and no dot traversal."
    },
    "integer": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]*)$",
      "maxLength": 4097,
      "$comment": "At most 4096 digits, excluding sign."
    },
    "application": {
      "type": "object",
      "required": [
        "profile",
        "formatVersion"
      ],
      "additionalProperties": false,
      "properties": {
        "profile": {
          "type": "string",
          "minLength": 1
        },
        "formatVersion": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "size",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "size": {
          "$ref": "#/$defs/counter"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "tip": {
      "type": "object",
      "required": [
        "replicaId",
        "sequence",
        "sha256"
      ],
      "additionalProperties": false,
      "properties": {
        "replicaId": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "sha256": {
          "$ref": "#/$defs/hash"
        }
      }
    },
    "frontier": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tip"
      },
      "uniqueItems": true
    },
    "value": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "null"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "bool"
            },
            "value": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "text"
            },
            "value": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "integer"
            },
            "value": {
              "$ref": "#/$defs/integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "coefficient",
            "exponent"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "decimal"
            },
            "coefficient": {
              "$ref": "#/$defs/integer"
            },
            "exponent": {
              "$ref": "#/$defs/integer"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "values"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "list"
            },
            "values": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/value"
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "entries"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "map"
            },
            "entries": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "key",
                  "value"
                ],
                "additionalProperties": false,
                "properties": {
                  "key": {
                    "type": "string"
                  },
                  "value": {
                    "$ref": "#/$defs/value"
                  }
                }
              }
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "collection",
            "id"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "record"
            },
            "collection": {
              "$ref": "#/$defs/name"
            },
            "id": {
              "$ref": "#/$defs/dot"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "type",
            "sha256",
            "size"
          ],
          "additionalProperties": false,
          "properties": {
            "type": {
              "const": "blob"
            },
            "sha256": {
              "$ref": "#/$defs/hash"
            },
            "size": {
              "$ref": "#/$defs/counter"
            }
          }
        }
      ],
      "$comment": "Typed-value depth at most 64; exact decimal normalization and exponent bounds are semantic checks."
    },
    "operation": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "op",
            "collection"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "create"
            },
            "collection": {
              "$ref": "#/$defs/name"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "record",
            "field",
            "present"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "assign"
            },
            "record": {
              "$ref": "#/$defs/dot"
            },
            "field": {
              "$ref": "#/$defs/name"
            },
            "present": {
              "type": "boolean"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          },
          "allOf": [
            {
              "if": {
                "properties": {
                  "present": {
                    "const": true
                  }
                }
              },
              "then": {
                "required": [
                  "value"
                ]
              },
              "else": {
                "not": {
                  "required": [
                    "value"
                  ]
                }
              }
            }
          ]
        },
        {
          "type": "object",
          "required": [
            "op",
            "record",
            "field",
            "value"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "set_add"
            },
            "record": {
              "$ref": "#/$defs/dot"
            },
            "field": {
              "$ref": "#/$defs/name"
            },
            "value": {
              "$ref": "#/$defs/value"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "record",
            "field",
            "value",
            "tags"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "set_remove"
            },
            "record": {
              "$ref": "#/$defs/dot"
            },
            "field": {
              "$ref": "#/$defs/name"
            },
            "value": {
              "$ref": "#/$defs/value"
            },
            "tags": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/dot"
              },
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "record"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "delete"
            },
            "record": {
              "$ref": "#/$defs/dot"
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "record",
            "field",
            "sequence",
            "owner",
            "after"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "place"
            },
            "record": {
              "$ref": "#/$defs/dot"
            },
            "field": {
              "$ref": "#/$defs/name"
            },
            "sequence": {
              "$ref": "#/$defs/name"
            },
            "owner": {
              "anyOf": [
                {
                  "$ref": "#/$defs/dot"
                },
                {
                  "type": "null"
                }
              ]
            },
            "after": {
              "anyOf": [
                {
                  "$ref": "#/$defs/dot"
                },
                {
                  "type": "null"
                }
              ]
            }
          }
        },
        {
          "type": "object",
          "required": [
            "op",
            "record",
            "field"
          ],
          "additionalProperties": false,
          "properties": {
            "op": {
              "const": "unplace"
            },
            "record": {
              "$ref": "#/$defs/dot"
            },
            "field": {
              "$ref": "#/$defs/name"
            }
          }
        }
      ]
    },
    "transaction": {
      "type": "object",
      "required": [
        "kind",
        "protocolVersion",
        "syncId",
        "rootSha256",
        "replicaId",
        "sequence",
        "previous",
        "dependencies",
        "lamport",
        "operations"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "darkbox-sync-transaction"
        },
        "protocolVersion": {
          "const": "1.0.0"
        },
        "syncId": {
          "$ref": "#/$defs/id"
        },
        "rootSha256": {
          "$ref": "#/$defs/hash"
        },
        "replicaId": {
          "$ref": "#/$defs/id"
        },
        "sequence": {
          "$ref": "#/$defs/counter"
        },
        "previous": {
          "anyOf": [
            {
              "$ref": "#/$defs/hash"
            },
            {
              "type": "null"
            }
          ]
        },
        "dependencies": {
          "$ref": "#/$defs/frontier"
        },
        "lamport": {
          "$ref": "#/$defs/counter"
        },
        "operations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/operation"
          },
          "minItems": 1,
          "maxItems": 4096
        }
      }
    },
    "segment": {
      "type": "object",
      "required": [
        "kind",
        "protocolVersion",
        "syncId",
        "rootSha256",
        "replicaId",
        "first",
        "last",
        "transactions"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "darkbox-sync-segment"
        },
        "protocolVersion": {
          "const": "1.0.0"
        },
        "syncId": {
          "$ref": "#/$defs/id"
        },
        "rootSha256": {
          "$ref": "#/$defs/hash"
        },
        "replicaId": {
          "$ref": "#/$defs/id"
        },
        "first": {
          "$ref": "#/$defs/counter"
        },
        "last": {
          "$ref": "#/$defs/counter"
        },
        "transactions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/transaction"
          },
          "minItems": 1,
          "maxItems": 256
        }
      }
    },
    "replica": {
      "type": "object",
      "required": [
        "kind",
        "protocolVersion",
        "syncId",
        "rootSha256",
        "replicaId",
        "deviceId",
        "label"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "darkbox-sync-replica"
        },
        "protocolVersion": {
          "const": "1.0.0"
        },
        "syncId": {
          "$ref": "#/$defs/id"
        },
        "rootSha256": {
          "$ref": "#/$defs/hash"
        },
        "replicaId": {
          "$ref": "#/$defs/id"
        },
        "deviceId": {
          "$ref": "#/$defs/id"
        },
        "label": {
          "type": "string",
          "maxLength": 1024,
          "$comment": "1024 UTF-8 bytes, not just characters."
        }
      }
    },
    "receipt": {
      "type": "object",
      "required": [
        "kind",
        "protocolVersion",
        "syncId",
        "rootSha256",
        "replicaId",
        "serial",
        "frontier"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "darkbox-sync-receipt"
        },
        "protocolVersion": {
          "const": "1.0.0"
        },
        "syncId": {
          "$ref": "#/$defs/id"
        },
        "rootSha256": {
          "$ref": "#/$defs/hash"
        },
        "replicaId": {
          "$ref": "#/$defs/id"
        },
        "serial": {
          "$ref": "#/$defs/counter"
        },
        "frontier": {
          "$ref": "#/$defs/frontier"
        }
      }
    },
    "domain": {
      "type": "object",
      "required": [
        "kind",
        "protocolVersion",
        "syncId",
        "packageId",
        "commonVersion",
        "application",
        "profile",
        "mapping",
        "encoding",
        "merge",
        "security"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "darkbox-sync-domain"
        },
        "protocolVersion": {
          "const": "1.0.0"
        },
        "syncId": {
          "$ref": "#/$defs/id"
        },
        "packageId": {
          "$ref": "#/$defs/id"
        },
        "commonVersion": {
          "const": "1.5.0"
        },
        "application": {
          "$ref": "#/$defs/application"
        },
        "profile": {
          "$ref": "#/$defs/file"
        },
        "mapping": {
          "$ref": "#/$defs/file"
        },
        "encoding": {
          "const": "jcs-strings-v1"
        },
        "merge": {
          "enum": [
            "causal-records-v1",
            "causal-records-seed-v1"
          ]
        },
        "security": {
          "const": "trusted-folder-plaintext"
        },
        "baseline": {
          "$ref": "#/$defs/file"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "baseline"
            ]
          },
          "then": {
            "properties": {
              "merge": {
                "const": "causal-records-seed-v1"
              }
            }
          },
          "else": {
            "properties": {
              "merge": {
                "const": "causal-records-v1"
              }
            }
          }
        }
      ]
    },
    "field": {
      "oneOf": [
        {
          "type": "object",
          "required": [
            "name",
            "kind",
            "columns",
            "codec",
            "valueTypes"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/name"
            },
            "kind": {
              "enum": [
                "register",
                "set"
              ]
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "$comment": "Also UTF-8 byte length <=255 and no NUL."
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "codec": {
              "$ref": "#/$defs/name"
            },
            "valueTypes": {
              "type": "array",
              "items": {
                "enum": [
                  "null",
                  "bool",
                  "text",
                  "integer",
                  "decimal",
                  "list",
                  "map",
                  "record",
                  "blob"
                ]
              },
              "minItems": 1,
              "uniqueItems": true
            }
          }
        },
        {
          "type": "object",
          "required": [
            "name",
            "kind",
            "columns",
            "codec",
            "valueTypes",
            "sequences",
            "ownerCollections",
            "allowRootOwner"
          ],
          "additionalProperties": false,
          "properties": {
            "name": {
              "$ref": "#/$defs/name"
            },
            "kind": {
              "const": "position"
            },
            "columns": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "$comment": "Also UTF-8 byte length <=255 and no NUL."
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "codec": {
              "$ref": "#/$defs/name"
            },
            "valueTypes": {
              "const": []
            },
            "sequences": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "ownerCollections": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/name"
              },
              "uniqueItems": true
            },
            "allowRootOwner": {
              "type": "boolean"
            }
          }
        }
      ]
    },
    "mapping": {
      "type": "object",
      "required": [
        "kind",
        "mappingVersion",
        "application",
        "storage",
        "collections",
        "projection"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "darkbox-sync-mapping"
        },
        "mappingVersion": {
          "const": "1.0.0"
        },
        "application": {
          "$ref": "#/$defs/application"
        },
        "storage": {
          "type": "object",
          "required": [
            "mode",
            "databasePath",
            "reservedPrefix"
          ],
          "additionalProperties": false,
          "properties": {
            "mode": {
              "enum": [
                "single-database",
                "journal-with-caches"
              ]
            },
            "databasePath": {
              "$ref": "#/$defs/path"
            },
            "reservedPrefix": {
              "const": "_darkbox_sync_"
            }
          }
        },
        "collections": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "name",
              "table",
              "idColumn",
              "fields",
              "localColumns"
            ],
            "additionalProperties": false,
            "properties": {
              "name": {
                "$ref": "#/$defs/name"
              },
              "table": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "$comment": "Also UTF-8 byte length <=255 and no NUL."
              },
              "idColumn": {
                "type": "string",
                "minLength": 1,
                "maxLength": 255,
                "$comment": "Also UTF-8 byte length <=255 and no NUL."
              },
              "fields": {
                "type": "array",
                "items": {
                  "$ref": "#/$defs/field"
                }
              },
              "localColumns": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 255,
                  "$comment": "Also UTF-8 byte length <=255 and no NUL."
                },
                "uniqueItems": true
              }
            }
          }
        },
        "projection": {
          "type": "object",
          "required": [
            "id",
            "version",
            "conflictPolicy",
            "documentationPath"
          ],
          "additionalProperties": false,
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            },
            "conflictPolicy": {
              "const": "quarantine"
            },
            "documentationPath": {
              "const": "profile/profile.md"
            }
          }
        }
      }
    },
    "recordState": {
      "type": "object",
      "required": [
        "id",
        "collection",
        "deletedBy",
        "registers",
        "sets",
        "positions"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/dot"
        },
        "collection": {
          "$ref": "#/$defs/name"
        },
        "deletedBy": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/dot"
          },
          "uniqueItems": true
        },
        "registers": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "field",
              "candidates"
            ],
            "additionalProperties": false,
            "properties": {
              "field": {
                "$ref": "#/$defs/name"
              },
              "candidates": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "dot",
                    "lamport",
                    "present"
                  ],
                  "additionalProperties": false,
                  "properties": {
                    "dot": {
                      "$ref": "#/$defs/dot"
                    },
                    "lamport": {
                      "$ref": "#/$defs/counter"
                    },
                    "present": {
                      "type": "boolean"
                    },
                    "value": {
                      "$ref": "#/$defs/value"
                    }
                  },
                  "allOf": [
                    {
                      "if": {
                        "properties": {
                          "present": {
                            "const": true
                          }
                        }
                      },
                      "then": {
                        "required": [
                          "value"
