{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:darkbox:manifest-schema:1.1.0",
  "title": "Darkbox 1.1.0 manifest",
  "description": "Structural validation only. Archive, canonical documentation bytes, path identity, SQLite and application profile checks are additional requirements.",
  "type": "object",
  "required": [
    "darkbox",
    "application",
    "folders",
    "databases"
  ],
  "additionalProperties": false,
  "properties": {
    "darkbox": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "darkbox"
        },
        "version": {
          "const": "1.1.0"
        }
      }
    },
    "application": {
      "type": "object",
      "required": [
        "id",
        "formatVersion",
        "profilePath"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "formatVersion": {
          "$ref": "#/$defs/version"
        },
        "profilePath": {
          "type": "string",
          "$ref": "#/$defs/path",
          "pattern": "/[^/]+\\.md$",
          "not": {
            "pattern": "^(?:extensions|docs/(?:sqlite|darkbox))(?:/|$)"
          },
          "description": "Archive-relative path to the required application data-format documentation.",
          "$comment": "Also check declared parent folders and separation from databases and canonical metadata."
        }
      }
    },
    "folders": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/folder"
      },
      "allOf": [
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "docs"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "docs/darkbox"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "docs/sqlite"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "docs/sqlite/images"
              }
            }
          }
        },
        {
          "contains": {
            "type": "object",
            "required": [
              "path"
            ],
            "properties": {
              "path": {
                "const": "docs/darkbox/protection"
              }
            }
          }
        }
      ]
    },
    "databases": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/database"
      }
    },
    "creator": {
      "type": "object",
      "required": [
        "id",
        "version"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "version": {
          "$ref": "#/$defs/version"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$",
          "not": {
            "pattern": "[^0-9TZ:.-]"
          }
        }
      }
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "$ref": "#/$defs/identifier"
      },
      "additionalProperties": {
        "$ref": "#/$defs/extension"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 255,
      "pattern": "^(?:[a-z][a-z0-9]*(?:-[a-z0-9]+)*\\.)+[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "not": {
        "pattern": "[^a-z0-9.-]"
      }
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "\\S"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "\\S"
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$",
      "not": {
        "pattern": "[^A-Za-z0-9_./-]"
      },
      "$comment": "Also check component byte length, device names, declared parents and case-folded collisions. These semantic checks are outside this schema."
    },
    "folder": {
      "type": "object",
      "required": [
        "path",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "$ref": "#/$defs/path"
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      }
    },
    "database": {
      "type": "object",
      "required": [
        "path",
        "description",
        "tables"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "$ref": "#/$defs/path",
          "not": {
            "pattern": "^docs/(?:sqlite|darkbox)(?:/|$)"
          }
        },
        "description": {
          "$ref": "#/$defs/description"
        },
        "userVersion": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2147483647
        },
        "tables": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/table"
          }
        }
      }
    },
    "table": {
      "type": "object",
      "required": [
        "name",
        "description"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 255,
          "pattern": "\\S"
        },
        "description": {
          "$ref": "#/$defs/description"
        }
      }
    },
    "extension": {
      "type": "object",
      "required": [
        "version",
        "required",
        "data"
      ],
      "additionalProperties": false,
      "properties": {
        "version": {
          "$ref": "#/$defs/version"
        },
        "required": {
          "type": "boolean"
        },
        "data": {
          "type": "object"
        }
      }
    }
  }
}
