{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:darkbox:extension-bundle-catalog-schema:1",
  "title": "Darkbox canonical extension bundle catalog",
  "type": "object",
  "required": ["extension", "folders", "files"],
  "additionalProperties": false,
  "properties": {
    "extension": {
      "type": "object",
      "required": ["namespace", "version"],
      "additionalProperties": false,
      "properties": {
        "namespace": { "type": "string", "pattern": "^studio\\.illegal\\.darkbox\\.[a-z](?:[a-z0-9-]*[a-z0-9])?$" },
        "version": { "type": "string", "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$" }
      }
    },
    "folders": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/path" }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "size", "sha256"],
        "additionalProperties": false,
        "properties": {
          "path": { "$ref": "#/$defs/path" },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "minLength": 64, "maxLength": 64, "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  },
  "$defs": {
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024,
      "pattern": "^docs/darkbox/[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?(?:/[A-Za-z0-9_-](?:[A-Za-z0-9._-]*[A-Za-z0-9_-])?)*$"
    }
  },
  "$comment": "Also check that every path is inside docs/darkbox/<name>/ for the namespace's final segment, sorted unique paths, coverage of every bundle file except the catalog itself, exact file lengths and SHA-256 values. The catalog is validated by comparison with the locally trusted reference for that extension version, not by an archive-supplied self-hash."
}
